# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info/
*.egg-info

# Virtual environments
.venv/
.venv

# Tool caches
.pytest_cache/
.ruff_cache/

# Generated example plots
examples/**/*.png
examples/*.png

# Notebook execution artefacts
examples/era5/notebooks/*.pt

# ERA5 inputs for the notebooks: both dates (2018-01-01, 2019-08-01) are tracked, 21 MB each, so
# the examples run from a fresh clone. The rule below is what would exclude them; keep it disabled.
#examples/era5/data/*.nc

# Seismic benchmark volumes: 1.2 GB of .npy, shipped as a downloadable package (see
# examples/seismic/README.md). Only the example code is tracked.
examples/seismic/data/**/*.npy
